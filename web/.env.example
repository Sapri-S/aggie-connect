# Copy to .env.local and fill in from Supabase: Project Settings → API Keys.
# Both values are public by design (they ship to the browser); RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Optional, server-only: lets admins invite people by email (src/lib/supabase/admin.ts).
# Secret: it bypasses RLS. Never commit it and never prefix it with NEXT_PUBLIC_.
# SUPABASE_SECRET_KEY=sb_secret_xxx

# Optional, public: shown on the privacy page and footer.
# NEXT_PUBLIC_CONTACT_EMAIL=aggieconnect.team@gmail.com

# "true" once Supabase has custom SMTP (docs/EMAIL-SETUP.md). Unset, the site
# hides forgot password, "send a new link" and invites.
# NEXT_PUBLIC_EMAIL_ENABLED=true

# Optional, public: Cloudflare Turnstile site key for the CAPTCHA. Set it
# (and redeploy) before enabling CAPTCHA in Supabase → Attack Protection.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...
